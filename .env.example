# Jira
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@your-company.com
JIRA_API_TOKEN=replace_me_atlassian_api_token

# (optional) extra JQL appended with AND. Example: project = ABC
# JIRA_EXTRA_JQL=

# Slack
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_USER_ID=U01ABC23DEF

# --- Summarization backend ---
# cli   : call a local coding-agent CLI (claude, codex, gemini, opencode) — NO API cost
# api   : call Anthropic API (requires ANTHROPIC_API_KEY below)
# none  : skip summaries
# unset : auto → cli if LLM_CLI is on PATH, else api if key present, else none
LLM_BACKEND=cli

# CLI command used when LLM_BACKEND=cli. The issue prompt is piped via stdin.
# Examples:
#   LLM_CLI="claude -p"          # Claude Code (default)
#   LLM_CLI="codex exec"         # Codex CLI
#   LLM_CLI="gemini -p"          # Gemini CLI
#   LLM_CLI="opencode run"       # OpenCode
LLM_CLI="claude -p"
LLM_CLI_TIMEOUT=90

# Only needed if LLM_BACKEND=api
# ANTHROPIC_API_KEY=sk-ant-replace-me
# LLM_MODEL=claude-haiku-4-5-20251001
